# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# cloudflare (local emulator state)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# agents & artifacts
.agents/
.artifacts/
.playwright-mcp/
.mcp.json

# Local quality reports
/.lighthouseci/
/test-results/
/playwright-report/
/tests/visual-baselines/
/.claude/
/.codex/
/.superpowers/

# Keep QCertify-specific skills versioned; third-party installs remain local.
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/qcertify-product-truth/
!.agents/skills/qcertify-ux-strategy/
!.agents/skills/qcertify-visual-system/
!.agents/skills/qcertify-quality-gates/

# Internal working notes and local AI prompts. This repository is PUBLIC: never publish these.
# docs/rebuild/ holds the product evidence ledger (including items marked "do not publish"),
# internal validation notes and strategy briefs. Prompt files are local scratch input.
/docs/rebuild/
/*prompt*.txt
/*prompt*.md
