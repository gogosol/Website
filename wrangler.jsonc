// Cloudflare Workers deployment of the static export (Workers Builds runs `npx wrangler deploy`).
//
// Workers static assets serve out/ with Pages-compatible routing (/platform -> platform.html,
// 404.html for unknown paths) and apply out/_headers and out/_redirects (copied from public/).
// Only /api/* invokes the Worker (worker/index.ts), which runs the contact handler from
// functions/api/contact.ts; every other request is a static asset and costs no invocation.
// Without this file, `wrangler deploy` auto-configures the project for OpenNext, which cannot
// deploy an `output: "export"` build.
{
  "name": "qcertify-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Builds out/ before deploying, whether or not the dashboard has a build command.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables set in the dashboard (CONTACT_TO_EMAIL, ...); secrets such as
  // RESEND_API_KEY are never removed by a deploy.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
