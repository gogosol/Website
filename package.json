{
  "name": "qcertify-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve-quality.mjs 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:lighthouse": "lhci autorun",
    "test:pa11y": "node scripts/pa11y.mjs",
    "quality": "npm run lint && npm run typecheck && npm run build && npm run test:e2e && npm run test:a11y && npm run test:pa11y && npm run test:lighthouse",
    "preview": "node scripts/serve-quality.mjs 3000",
    "cf:preview": "npx wrangler@4 pages dev out --port 8788"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pa11y-ci": "5.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
